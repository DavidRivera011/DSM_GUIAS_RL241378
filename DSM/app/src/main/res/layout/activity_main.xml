<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Calculadora de propinas para grupos tacaños"
                android:textAlignment="center"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewMontoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Monto Total"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewTitle" />

            <EditText
                android:id="@+id/montoT"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Ingrese el monto total"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewMontoLabel" />

            <TextView
                android:id="@+id/textViewPersonasLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Número de personas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/montoT" />

            <EditText
                android:id="@+id/numPersonas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Ingrese el número de personas"
                android:inputType="number"
                android:minHeight="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewPersonasLabel" />

            <TextView
                android:id="@+id/textViewPropinaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Seleccione Propina"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numPersonas" />

            <RadioGroup
                android:id="@+id/radioGroupPropina"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewPropinaLabel">

                <RadioButton
                    android:id="@+id/num10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10%" />

                <RadioButton
                    android:id="@+id/num15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15%" />

                <RadioButton
                    android:id="@+id/num20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20%" />

                <RadioButton
                    android:id="@+id/otro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Otro" />
            </RadioGroup>

            <EditText
                android:id="@+id/propPersonalizada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Propina personalizada (%)"
                android:inputType="number"
                android:minHeight="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/radioGroupPropina" />

            <TextView
                android:id="@+id/textViewIvaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Incluir IVA"
                app:layout_constraintBottom_toBottomOf="@+id/iva"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iva" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/iva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                app:layout_constraintStart_toEndOf="@id/textViewIvaLabel"
                app:layout_constraintTop_toBottomOf="@id/propPersonalizada" />

            <Button
                android:id="@+id/calcular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:text="Calcular"
                app:layout_constraintEnd_toStartOf="@+id/limpiar"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iva" />

            <Button
                android:id="@+id/limpiar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Limpiar"
                app:layout_constraintBottom_toBottomOf="@+id/calcular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/calcular"
                app:layout_constraintTop_toTopOf="@+id/calcular" />

            <LinearLayout
                android:id="@+id/resultsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="#F5F5F5"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/calcular">

                <TextView
                    android:id="@+id/propina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Propina: "
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Total a pagar: "
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/porPersona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Por persona: "
                    android:textSize="16sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>